#include "Global.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(LIVECONTAINER_BUNDLE_IDENTIFIER)

// StikJIT ships for devices only, so a Simulator build embeds none of it.
EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*] = StikJIT.framework

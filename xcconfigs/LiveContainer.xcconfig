#include "Global.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = $(LIVECONTAINER_BUNDLE_IDENTIFIER)

// StikJIT, the pairing library and the Location Spoofer ship for devices only,
// so a Simulator build embeds none of them.
EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*] = StikJIT.framework IdevicePairing.dylib LocationSpoofer.dylib
